{
  "name": "rev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rev \u2014 campus rides and intercity travel for students and everyone.",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "serve": "npm run build && npm start",
    "seed": "tsx server/seed.ts",
    "seed:reset": "REV_RESET=1 tsx server/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:api && npm run test:ui",
    "test:api": "node tests/api-smoke.mjs",
    "test:ui": "tsx tests/ui-smoke.tsx",
    "setup": "npm install && npm run seed && npm run build"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}